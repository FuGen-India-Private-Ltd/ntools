<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- Complete Checkbox Action Button -->
    <TextView
        android:id="@+id/btn_item_complete"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:text="○"
        android:textColor="#34D399"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/item_task_click_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Task Title"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_task_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Today at 15:30 • High"
            android:textColor="#CBD5E1"
            android:textSize="11.5sp" />
    </LinearLayout>

</LinearLayout>
