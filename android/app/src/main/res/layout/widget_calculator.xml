<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Top Display Header & Enlarge Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_calc_display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Enlarge button opens full app calculator -->
        <TextView
            android:id="@+id/btn_calc_enlarge"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:text="⛶"
            android:textColor="#60A5FA"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="4dp"
        android:background="#26FFFFFF" />

    <!-- Keypad Row 1: 7, 8, 9, ÷ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/btn_calc_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="7" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_calc_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="8" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_calc_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="9" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_calc_div" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="÷" android:textColor="#60A5FA" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Keypad Row 2: 4, 5, 6, × -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/btn_calc_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="4" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_calc_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="5" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_calc_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="6" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_calc_mul" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="×" android:textColor="#60A5FA" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Keypad Row 3: 1, 2, 3, − -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/btn_calc_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="1" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_calc_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="2" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_calc_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="3" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_calc_sub" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="−" android:textColor="#60A5FA" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Keypad Row 4: C, 0, =, + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/btn_calc_clear" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="C" android:textColor="#F87171" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_calc_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="0" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_calc_eq" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="=" android:textColor="#34D399" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_calc_add" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:background="@drawable/widget_btn_bg" android:gravity="center" android:text="+" android:textColor="#60A5FA" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
