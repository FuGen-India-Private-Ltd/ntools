<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:text="⏰"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Task Reminder"
                android:textColor="#F59E0B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlay_task_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scheduled for 15:30"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#22FFFFFF" />

    <!-- Task Title & Description -->
    <TextView
        android:id="@+id/overlay_task_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kannada Literature Exam Revision"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/overlay_task_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Review Kuvempu and Bendre poetry notes"
        android:textColor="#CBD5E1"
        android:textSize="12sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_overlay_dismiss"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:text="Dismiss"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_overlay_snooze"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_bg"
            android:text="Snooze 10m"
            android:textColor="#F8FAFC"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_overlay_complete"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="#10B981"
            android:text="✓ Complete"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
